[Unit]
Description=omavcam daemon socket
# Installed to /usr/lib/systemd/user by omavcam-git, and enabled there by the
# sockets.target.wants symlink the package ships — so a fresh install has an
# engine without anyone running systemctl.

[Socket]
# %t is XDG_RUNTIME_DIR for a --user unit, which is where the CLI looks.
ListenStream=%t/omavcam.sock
SocketMode=0600

[Install]
WantedBy=sockets.target
