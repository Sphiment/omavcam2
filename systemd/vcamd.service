[Unit]
Description=vcamd daemon
Requires=vcamd.socket
After=vcamd.socket

[Service]
# Started by vcamd.socket, so no [Install]: connecting to the socket is what
# brings it up. Being a systemd unit rather than an Omarchy `service` plugin
# (a QML singleton) is what makes it survive omarchy-restart-shell.
ExecStart=/usr/bin/vcamd daemon
# Journald picks stderr up on its own.
