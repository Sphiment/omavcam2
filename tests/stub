#!/bin/sh
# One stub for adb, scrcpy and modprobe: copied under each of those names by
# the test harness, ahead of the real ones on PATH. It records the argv it was
# called with and prints whatever the test scripted for it.
#
#   $OMAVCAM_STUB_LOG    appended one line per call: "<tool> <args...>"
#   $OMAVCAM_STUB_DIR    <tool>.out  printed on stdout, if present
#                        <tool>.code exit status, if present
tool=${0##*/}
printf '%s\n' "$tool $*" >>"$OMAVCAM_STUB_LOG"
[ -f "$OMAVCAM_STUB_DIR/$tool.out" ] && cat "$OMAVCAM_STUB_DIR/$tool.out"
if [ -f "$OMAVCAM_STUB_DIR/$tool.code" ]; then
  exit "$(cat "$OMAVCAM_STUB_DIR/$tool.code")"
fi
exit 0
